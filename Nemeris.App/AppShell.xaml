<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Nemeris.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Nemeris.App.Views"
    Title="Nemeris">

    <!-- Registered in DI, so Shell resolves the page (and its ViewModel) from the container. -->
    <ShellContent
        Title="Products"
        ContentTemplate="{DataTemplate views:ProductListPage}"
        Route="products" />

</Shell>
