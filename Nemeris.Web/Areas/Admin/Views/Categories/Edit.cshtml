@model CategoryUpsertDto
@{
    ViewData["Title"] = L["Admin.EditCategory"];
    Guid categoryId = ViewBag.CategoryId;
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
}

<h1 class="mb-4">@L["Admin.EditCategory"]</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" asp-route-id="@categoryId" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">@L["Field.Name"]</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label">@L["Field.Slug"]</label>
                <input asp-for="Slug" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">@L["Field.Description"]</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="ParentCategoryId" class="form-label">@L["Field.ParentCategory"]</label>
                <select asp-for="ParentCategoryId" class="form-select">
                    <option value="">@L["Admin.NoParent"]</option>
                    @* A category can't be its own parent, so it is excluded from the list. *@
                    @foreach (var category in categories.Where(c => c.Id != categoryId))
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">@L["Common.Save"]</button>
            <a class="btn btn-outline-secondary" asp-action="Index">@L["Common.Cancel"]</a>
        </form>
    </div>
</div>
