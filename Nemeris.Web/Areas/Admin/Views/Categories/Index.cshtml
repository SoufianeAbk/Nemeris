@model IReadOnlyList<Category>
@{
    ViewData["Title"] = L["Admin.Categories"];
    var byId = Model.ToDictionary(c => c.Id);
}

<h1 class="mb-4">@L["Admin.Categories"]</h1>

@* Inline create form — categories are simple enough to not need a separate page. *@
<div class="card mb-4">
    <div class="card-header">@L["Admin.NewCategory"]</div>
    <div class="card-body">
        <form asp-action="Create" method="post" class="row g-2">
            <div class="col-md-3">
                <input type="text" name="Name" class="form-control" placeholder="@L["Field.Name"]" required />
            </div>
            <div class="col-md-3">
                <input type="text" name="Slug" class="form-control" placeholder="@L["Field.Slug"]" required />
            </div>
            <div class="col-md-4">
                <select name="ParentCategoryId" class="form-select">
                    <option value="">@L["Admin.NoParent"]</option>
                    @foreach (var category in Model)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">@L["Common.Save"]</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-secondary">@L["Admin.NoResults"]</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@L["Field.Name"]</th>
                <th>@L["Field.Slug"]</th>
                <th>@L["Field.ParentCategory"]</th>
                <th class="text-end">@L["Common.Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td><code>@category.Slug</code></td>
                    <td>
                        @if (category.ParentCategoryId is Guid parentId && byId.TryGetValue(parentId, out var parent))
                        {
                            @parent.Name
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@category.Id">@L["Common.Edit"]</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@L["Common.ConfirmDelete"]');">
                            <button type="submit" class="btn btn-outline-danger btn-sm">@L["Common.Delete"]</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
