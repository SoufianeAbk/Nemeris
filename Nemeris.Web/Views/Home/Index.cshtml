@model IReadOnlyList<Product>
@{
    ViewData["Title"] = L["Nav.Home"];
}

<section class="hero">
    <span class="hero-eyebrow"><i class="bi bi-stars"></i>@L["Home.HeroEyebrow"]</span>
    <h1>@L["Home.HeroTitle"]</h1>
    <p class="lead">@L["Home.HeroSubtitle"]</p>
    <div class="d-flex flex-wrap justify-content-center gap-2">
        <a class="btn btn-light btn-lg px-4" asp-controller="Product" asp-action="Index">
            @L["Home.ShopNow"] <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</section>

<section class="row g-3" aria-label="@L["Footer.Support"]">
    <div class="col-md-3 col-6">
        <div class="usp-item">
            <span class="usp-icon"><i class="bi bi-truck"></i></span>
            <div>
                <h3>@L["Home.USP1Title"]</h3>
                <p>@L["Home.USP1Text"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="usp-item">
            <span class="usp-icon"><i class="bi bi-arrow-return-left"></i></span>
            <div>
                <h3>@L["Home.USP2Title"]</h3>
                <p>@L["Home.USP2Text"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="usp-item">
            <span class="usp-icon"><i class="bi bi-shield-check"></i></span>
            <div>
                <h3>@L["Home.USP3Title"]</h3>
                <p>@L["Home.USP3Text"]</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="usp-item">
            <span class="usp-icon"><i class="bi bi-chat-dots"></i></span>
            <div>
                <h3>@L["Home.USP4Title"]</h3>
                <p>@L["Home.USP4Text"]</p>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="section-head">
        <h2>@L["Home.Featured"]</h2>
        <a class="section-link" asp-controller="Product" asp-action="Index">
            @L["Home.ViewAll"] <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var product in Model)
        {
            <div class="col">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
</section>
