@model IReadOnlyList<Product>
@{
    ViewData["Title"] = L["Nav.Home"];
}

<section class="p-5 mb-4 bg-light rounded-3 text-center">
    <h1 class="display-5 fw-bold">@L["Home.HeroTitle"]</h1>
    <p class="lead">@L["Home.HeroSubtitle"]</p>
    <a class="btn btn-primary btn-lg" asp-controller="Product" asp-action="Index">@L["Home.ShopNow"]</a>
</section>

<h2 class="mb-3">@L["Home.Featured"]</h2>

<div class="row row-cols-2 row-cols-md-4 g-3">
    @foreach (var product in Model)
    {
        <div class="col">
            <div class="card h-100">
                @if (!string.IsNullOrEmpty(product.ImageUrl))
                {
                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="object-fit: cover; height: 180px;" />
                }
                else
                {
                    <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 180px;">
                        <span class="text-muted fs-1">📦</span>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text mt-auto mb-2">
                        @* Prices are always in euro; only the number format follows the culture. *@
                        <strong>€ @product.Price.ToString("N2")</strong>
                        @if (product.CompareAtPrice is decimal compareAt)
                        {
                            <span class="text-muted text-decoration-line-through ms-1">€ @compareAt.ToString("N2")</span>
                        }
                    </p>
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Product" asp-action="Details" asp-route-slug="@product.Slug">
                        @product.Category?.Name
                    </a>
                </div>
            </div>
        </div>
    }
</div>
