@model Product

<article class="card product-card h-100">
    <a class="product-card-media" asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
        }
        else
        {
            <span class="product-card-placeholder"><i class="bi bi-box-seam"></i></span>
        }
        @if (Model.CompareAtPrice is decimal compare && compare > Model.Price)
        {
            <span class="badge-sale">-@((int)Math.Round(100 - Model.Price / compare * 100))%</span>
        }
    </a>
    <div class="card-body d-flex flex-column">
        @if (Model.Category is not null)
        {
            <span class="product-card-category">@Model.Category.Name</span>
        }
        <h3 class="product-card-title">
            <a asp-controller="Product" asp-action="Details" asp-route-slug="@Model.Slug">@Model.Name</a>
        </h3>
        <p class="mt-auto mb-2">
            @* Prices are always in euro; only the number format follows the culture. *@
            <span class="price">€ @Model.Price.ToString("N2")</span>
            @if (Model.CompareAtPrice is decimal compareAt)
            {
                <span class="price-compare">€ @compareAt.ToString("N2")</span>
            }
        </p>
        @if (Model.StockQuantity > 0)
        {
            <form asp-controller="Cart" asp-action="Add" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-sm w-100">
                    <i class="bi bi-bag-plus me-1"></i>@L["Products.AddToCart"]
                </button>
            </form>
        }
        else
        {
            <button class="btn btn-secondary btn-sm w-100" disabled>@L["Products.OutOfStock"]</button>
        }
    </div>
</article>
