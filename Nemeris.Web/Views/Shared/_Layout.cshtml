@using System.Globalization
@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;

    string NavActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nemeris</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Sora:wght@600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Nemeris.Web.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span>
                    Nemeris
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-between">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Product")" asp-area="" asp-controller="Product" asp-action="Index">@L["Nav.Products"]</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">@L["Nav.Admin"]</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Cart")" asp-area="" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-bag me-1"></i>@L["Nav.Cart"]
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Orders">@L["Nav.MyOrders"]</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Addresses">@L["Nav.MyAddresses"]</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item">@L["Nav.Logout"]</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Account", "Login")" asp-area="" asp-controller="Account" asp-action="Login">@L["Nav.Login"]</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Account", "Register")" asp-area="" asp-controller="Account" asp-action="Register">@L["Nav.Register"]</a>
                            </li>
                        }
                        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
                            @* Cookie-based culture switch: posts to Home/SetLanguage and returns to this page. *@
                            <form asp-area="" asp-controller="Home" asp-action="SetLanguage" method="post">
                                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                <select name="culture" class="form-select form-select-sm lang-select" onchange="this.form.submit()"
                                        aria-label="Language">
                                    @{
                                        var current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                                    }
                                    <option value="en" selected="@(current == "en")">EN</option>
                                    <option value="nl" selected="@(current == "nl")">NL</option>
                                    <option value="fr" selected="@(current == "fr")">FR</option>
                                </select>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container pt-4 flex-grow-1">
        @* Flash messages set by controllers (checkout errors, cart confirmations, …). *@
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @success
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Info"] is string info)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                @info
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-main row g-4">
                <div class="col-lg-4 col-md-6">
                    <a class="footer-brand" asp-area="" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark"><i class="bi bi-box-seam-fill"></i></span>
                        Nemeris
                    </a>
                    <p class="footer-tagline">@L["Footer.Tagline"]</p>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="X"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 col-6 offset-lg-1">
                    <h6>@L["Footer.Shop"]</h6>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Index">@L["Nav.Home"]</a></li>
                        <li><a asp-area="" asp-controller="Product" asp-action="Index">@L["Nav.Products"]</a></li>
                        <li><a asp-area="" asp-controller="Cart" asp-action="Index">@L["Nav.Cart"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>@L["Footer.Support"]</h6>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="Faq">@L["Nav.Faq"]</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Contact">@L["Nav.Contact"]</a></li>
                        <li><a asp-area="" asp-controller="Account" asp-action="Orders">@L["Nav.MyOrders"]</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 col-6">
                    <h6>@L["Footer.Company"]</h6>
                    <ul class="footer-links">
                        <li><a asp-area="" asp-controller="Home" asp-action="About">@L["Nav.About"]</a></li>
                        <li><a asp-area="" asp-controller="Home" asp-action="Privacy">@L["Nav.Privacy"]</a></li>
                    </ul>
                </div>
            </div>
            <div class="site-footer-bottom">
                <span>&copy; @DateTime.Now.Year Nemeris — @L["Footer.Rights"]</span>
                <span class="footer-payments" aria-hidden="true">
                    <i class="bi bi-credit-card-2-front"></i>
                    <i class="bi bi-paypal"></i>
                    <i class="bi bi-bank"></i>
                </span>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
