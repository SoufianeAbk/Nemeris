@model ProductListViewModel
@{
    ViewData["Title"] = L["Products.Title"];
}

<h1 class="mb-3">@L["Products.Title"]</h1>

@* GET form: field names match ProductFilterDto so binding and pager links stay in sync. *@
<form method="get" asp-controller="Product" asp-action="Index" class="row g-2 mb-4">
    <div class="col-sm-4">
        <input type="text" name="Search" value="@Model.Filter.Search" class="form-control"
               placeholder="@L["Products.Search"]" />
    </div>
    <div class="col-sm-3">
        <select name="CategoryId" class="form-select">
            <option value="">@L["Products.AllCategories"]</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id" selected="@(Model.Filter.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-sm-3">
        <select name="SortBy" class="form-select">
            <option value="name" selected="@(Model.Filter.SortBy is null or "name")">@L["Products.SortName"]</option>
            <option value="price" selected="@(Model.Filter.SortBy == "price")">@L["Products.SortPriceAsc"]</option>
            <option value="price_desc" selected="@(Model.Filter.SortBy == "price_desc")">@L["Products.SortPriceDesc"]</option>
            <option value="newest" selected="@(Model.Filter.SortBy == "newest")">@L["Products.SortNewest"]</option>
        </select>
    </div>
    <div class="col-sm-2">
        <button type="submit" class="btn btn-primary w-100">@L["Products.Apply"]</button>
    </div>
</form>

@if (Model.Products.Items.Count == 0)
{
    <div class="alert alert-secondary">@L["Products.NoResults"]</div>
}
else
{
    <div class="row row-cols-2 row-cols-md-4 g-3">
        @foreach (var product in Model.Products.Items)
        {
            <div class="col">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="object-fit: cover; height: 180px;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center" style="height: 180px;">
                            <span class="text-muted fs-1">📦</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">
                            <a class="text-decoration-none" asp-controller="Product" asp-action="Details" asp-route-slug="@product.Slug">
                                @product.Name
                            </a>
                        </h6>
                        <small class="text-muted mb-2">@product.Category?.Name</small>
                        <p class="card-text mt-auto mb-2">
                            <strong>€ @product.Price.ToString("N2")</strong>
                            @if (product.CompareAtPrice is decimal compareAt)
                            {
                                <span class="text-muted text-decoration-line-through ms-1">€ @compareAt.ToString("N2")</span>
                            }
                        </p>
                        @if (product.StockQuantity > 0)
                        {
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-primary btn-sm w-100">@L["Products.AddToCart"]</button>
                            </form>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm w-100" disabled>@L["Products.OutOfStock"]</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-4" aria-label="Pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Products.HasPreviousPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Products.Page - 1)"
                   asp-route-search="@Model.Filter.Search"
                   asp-route-categoryId="@Model.Filter.CategoryId"
                   asp-route-sortBy="@Model.Filter.SortBy">@L["Products.Previous"]</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Model.Products.Page / @Math.Max(1, Model.Products.TotalPages)</span>
            </li>
            <li class="page-item @(Model.Products.HasNextPage ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Products.Page + 1)"
                   asp-route-search="@Model.Filter.Search"
                   asp-route-categoryId="@Model.Filter.CategoryId"
                   asp-route-sortBy="@Model.Filter.SortBy">@L["Products.Next"]</a>
            </li>
        </ul>
    </nav>
}
