@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row g-4 align-items-start">
    <div class="col-md-5">
        <div class="card overflow-hidden">
            <div class="product-card-media" style="aspect-ratio: 1 / 1;">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" />
                }
                else
                {
                    <span class="product-card-placeholder"><i class="bi bi-box-seam"></i></span>
                }
                @if (Model.CompareAtPrice is decimal saleCompare && saleCompare > Model.Price)
                {
                    <span class="badge-sale">-@((int)Math.Round(100 - Model.Price / saleCompare * 100))%</span>
                }
            </div>
        </div>
    </div>
    <div class="col-md-7">
        <span class="product-card-category">@Model.Category?.Name</span>
        <h1 class="mb-1">@Model.Name</h1>
        <p class="text-muted">@L["Product.Sku"]: @Model.Sku</p>
        <p class="fs-3 mb-3">
            <span class="price fs-3">€ @Model.Price.ToString("N2")</span>
            @if (Model.CompareAtPrice is decimal compareAt)
            {
                <span class="price-compare fs-5">€ @compareAt.ToString("N2")</span>
            }
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-secondary mb-4">@Model.Description</p>
        }

        @if (Model.StockQuantity > 0)
        {
            <p class="text-success fw-medium mb-3">
                <i class="bi bi-check-circle-fill me-1"></i>@L["Product.InStock"]: @Model.StockQuantity
            </p>
            <form asp-controller="Cart" asp-action="Add" method="post" class="row g-2" style="max-width: 340px;">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="col-4">
                    <input type="number" name="quantity" value="1" min="1" max="999" class="form-control"
                           aria-label="@L["Product.Quantity"]" />
                </div>
                <div class="col-8">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-bag-plus me-1"></i>@L["Products.AddToCart"]
                    </button>
                </div>
            </form>
        }
        else
        {
            <p><span class="badge bg-secondary fs-6">@L["Products.OutOfStock"]</span></p>
        }

        <a class="btn btn-link ps-0 mt-3" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>@L["Common.Back"]</a>
    </div>
</div>
