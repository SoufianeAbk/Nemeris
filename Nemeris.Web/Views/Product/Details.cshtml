@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="row g-4">
    <div class="col-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" class="img-fluid rounded" alt="@Model.Name" />
        }
        else
        {
            <div class="bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center rounded" style="height: 320px;">
                <span class="text-muted display-1">📦</span>
            </div>
        }
    </div>
    <div class="col-md-7">
        <h1>@Model.Name</h1>
        <p class="text-muted">
            @Model.Category?.Name &middot; @L["Product.Sku"]: @Model.Sku
        </p>
        <p class="fs-3 mb-1">
            <strong>€ @Model.Price.ToString("N2")</strong>
            @if (Model.CompareAtPrice is decimal compareAt)
            {
                <span class="text-muted text-decoration-line-through fs-5 ms-2">€ @compareAt.ToString("N2")</span>
            }
        </p>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="mt-3">@Model.Description</p>
        }

        @if (Model.StockQuantity > 0)
        {
            <p class="text-success mb-3">@L["Product.InStock"]: @Model.StockQuantity</p>
            <form asp-controller="Cart" asp-action="Add" method="post" class="row g-2" style="max-width: 320px;">
                <input type="hidden" name="productId" value="@Model.Id" />
                <div class="col-4">
                    <input type="number" name="quantity" value="1" min="1" max="999" class="form-control"
                           aria-label="@L["Product.Quantity"]" />
                </div>
                <div class="col-8">
                    <button type="submit" class="btn btn-primary w-100">@L["Products.AddToCart"]</button>
                </div>
            </form>
        }
        else
        {
            <p><span class="badge bg-secondary fs-6">@L["Products.OutOfStock"]</span></p>
        }

        <a class="btn btn-link ps-0 mt-3" asp-action="Index">&larr; @L["Common.Back"]</a>
    </div>
</div>
