@model LoginViewModel
@{
    ViewData["Title"] = L["Account.LoginTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-4">@L["Account.LoginTitle"]</h1>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">@L["Account.Email"]</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">@L["Account.Password"]</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label">@L["Account.RememberMe"]</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">@L["Account.LoginTitle"]</button>
        </form>

        <p class="mt-3">
            @L["Account.NoAccount"] <a asp-action="Register">@L["Nav.Register"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
