@model RegisterViewModel
@{
    ViewData["Title"] = L["Account.RegisterTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-4">@L["Account.RegisterTitle"]</h1>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-sm-6 mb-3">
                    <label asp-for="FirstName" class="form-label">@L["Account.FirstName"]</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-sm-6 mb-3">
                    <label asp-for="LastName" class="form-label">@L["Account.LastName"]</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">@L["Account.Email"]</label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">@L["Account.Password"]</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">@L["Account.ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">@L["Account.RegisterTitle"]</button>
        </form>

        <p class="mt-3">
            @L["Account.HaveAccount"] <a asp-action="Login">@L["Nav.Login"]</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
