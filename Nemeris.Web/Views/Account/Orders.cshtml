@model PagedList<Order>
@{
    ViewData["Title"] = L["Account.OrdersTitle"];
}

<h1 class="mb-4">@L["Account.OrdersTitle"]</h1>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-secondary">@L["Account.NoOrders"]</div>
    <a class="btn btn-primary" asp-controller="Product" asp-action="Index">@L["Cart.BrowseProducts"]</a>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>@L["Order.Number"]</th>
                <th>@L["Order.Date"]</th>
                <th>@L["Order.Status"]</th>
                <th>@L["Order.Payment"]</th>
                <th class="text-end">@L["Order.Total"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Items)
            {
                <tr>
                    <td>@order.OrderNumber</td>
                    <td>@order.CreatedAt.ToString("d")</td>
                    <td><span class="badge @StatusBadge(order.Status)">@L[$"Status.{order.Status}"]</span></td>
                    <td>@L[$"Payment.{order.PaymentStatus}"]</td>
                    <td class="text-end">€ @order.Total.ToString("N2")</td>
                    <td class="text-end">
                        <a class="btn btn-outline-secondary btn-sm"
                           asp-controller="Cart" asp-action="Confirmation" asp-route-id="@order.Id">
                            @L["Common.Details"]
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <nav aria-label="Pagination">
        <ul class="pagination">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Orders" asp-route-page="@(Model.Page - 1)">@L["Products.Previous"]</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Page / @Math.Max(1, Model.TotalPages)</span></li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Orders" asp-route-page="@(Model.Page + 1)">@L["Products.Next"]</a>
            </li>
        </ul>
    </nav>
}

@functions {
    private static string StatusBadge(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Delivered => "bg-success",
        OrderStatus.Cancelled or OrderStatus.Refunded => "bg-danger",
        _ => "bg-info text-dark",
    };
}
